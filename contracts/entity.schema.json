{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "entity",
  "title": "Entity",
  "description": "A single emitter entity within a scenario.",
  "type": "object",
  "required": ["label", "position", "frequency", "power", "azimuth", "antenna_height", "radius"],
  "additionalProperties": false,
  "properties": {
    "label": {
      "x-recalc": "none",
      "type": "string",
      "title": "Label"
    },
    "position": {
      "x-recalc": "engine",
      "type": "object",
      "title": "Position",
      "x-ui-component": "coordinate",
      "required": ["lat", "lon"],
      "additionalProperties": false,
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "frequency": {
      "x-recalc": "engine",
      "title": "Frequency",
      "x-ui-component": "numeric-or-file",
      "x-unit": "MHz",
      "oneOf": [
        { "type": "number" },
        { "type": "string", "minLength": 1 }
      ]
    },
    "power": {
      "x-recalc": "engine",
      "title": "Power",
      "x-ui-component": "numeric-or-file",
      "x-unit": "dBm",
      "oneOf": [
        { "type": "number" },
        { "type": "string", "minLength": 1 }
      ]
    },
    "azimuth": {
      "x-recalc": "engine",
      "type": "number",
      "title": "Azimuth",
      "minimum": 0,
      "maximum": 360,
      "x-unit": "°"
    },
    "beam_width": {
      "x-recalc": "engine",
      "type": "number",
      "title": "Beam Width",
      "description": "Vertical half-power beamwidth of the antenna. The antenna covers the full 360° horizontally. Omitted = no vertical gain pattern (isotropic).",
      "minimum": 1,
      "maximum": 180,
      "x-unit": "°"
    },
    "tilt": {
      "x-recalc": "engine",
      "type": "number",
      "title": "Antenna Tilt",
      "description": "Elevation of the beam's main axis above the horizon. Negative = downtilt.",
      "minimum": -90,
      "maximum": 90,
      "default": 0,
      "x-unit": "°",
      "x-paired-with": "beam_width"
    },
    "antenna_height": {
      "x-recalc": "engine",
      "type": "number",
      "title": "Antenna Height",
      "minimum": 0,
      "x-unit": "m"
    },
    "radius": {
      "x-recalc": "engine",
      "type": "number",
      "title": "Radius",
      "minimum": 0.1,
      "x-unit": "km"
    }
  }
}
