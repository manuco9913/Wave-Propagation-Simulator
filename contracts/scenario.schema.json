{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "scenario",
  "title": "Scenario",
  "description": "A wave propagation scenario with one or more entities.",
  "type": "object",
  "required": [
    "name",
    "height_range",
    "height_step",
    "height_reference",
    "angular_resolution",
    "distance_step",
    "grid_cell_size",
    "terrain_enabled",
    "combination_method",
    "entities"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "x-recalc": "none",
      "type": "string",
      "title": "Name",
      "minLength": 1
    },
    "height_range": {
      "x-recalc": "engine",
      "type": "object",
      "title": "Height Range",
      "x-ui-component": "range",
      "x-unit": "m",
      "required": ["min", "max"],
      "additionalProperties": false,
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" }
      }
    },
    "height_step": {
      "x-recalc": "engine",
      "type": "number",
      "title": "Height Step",
      "minimum": 1,
      "x-unit": "m"
    },
    "height_reference": {
      "x-recalc": "engine",
      "type": "string",
      "title": "Height Reference",
      "description": "Whether the height axis (height_range) is measured above ground or above sea level.",
      "enum": ["ground", "sea_level"],
      "default": "ground"
    },
    "angular_resolution": {
      "x-recalc": "engine",
      "type": "number",
      "title": "Angular Resolution",
      "minimum": 0.01,
      "maximum": 2.0,
      "default": 0.1,
      "x-unit": "°"
    },
    "distance_step": {
      "x-recalc": "engine",
      "type": "number",
      "title": "Distance Step",
      "description": "Spacing between samples along each ray, from the entity outward.",
      "minimum": 10,
      "default": 100,
      "x-unit": "m"
    },
    "grid_cell_size": {
      "x-recalc": "slice",
      "type": "number",
      "title": "Grid Cell Size",
      "minimum": 1,
      "default": 100,
      "x-unit": "m"
    },
    "terrain_enabled": {
      "x-recalc": "engine",
      "type": "boolean",
      "title": "Terrain Enabled",
      "default": true
    },
    "combination_method": {
      "x-recalc": "slice",
      "type": "string",
      "title": "Combination Method",
      "enum": ["max", "mean", "sum"],
      "default": "max"
    },
    "entities": {
      "x-recalc": "engine",
      "type": "array",
      "title": "Entities",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "$ref": "entity"
      }
    }
  }
}
